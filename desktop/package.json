{
  "name": "keyflux-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "node scripts/tauri.mjs build",
    "prepare:core": "node scripts/prepare-core.mjs",
    "assets:fetch": "node scripts/reference-assets.mjs",
    "frontend:dev": "vite --host 127.0.0.1",
    "frontend:build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/dev.mjs --check",
    "test:ui": "playwright test",
    "format:check": "prettier --check src scripts tests *.ts *.json index.html src-tauri/*.json src-tauri/capabilities/*.json",
    "format": "prettier --write src scripts tests *.ts *.json index.html src-tauri/*.json src-tauri/capabilities/*.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
