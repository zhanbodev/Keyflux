{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Local settings, theme editing and explicit verified-device control only.",
  "windows": ["settings"],
  "permissions": [
    "allow-get-status",
    "allow-get-theme",
    "allow-save-theme",
    "allow-import-theme",
    "allow-export-theme",
    "allow-get-device",
    "allow-connect-device",
    "allow-disconnect-device",
    "allow-acknowledge-task",
    "allow-open-task"
  ]
}
