{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyflux",
  "version": "0.1.0",
  "identifier": "tech.nuclx.keyflux.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Keyflux",
        "width": 1120,
        "height": 880,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "externalBin": ["binaries/keyflux"],
    "resources": [
      "../../LICENSE",
      "../../THIRD_PARTY_NOTICES.md",
      "../../licenses/NuPhyLab-MIT.txt",
      "../../vendor/hidapi/LICENSE-bsd.txt"
    ]
  }
}
