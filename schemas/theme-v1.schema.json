{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyflux.local/schemas/theme-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "default": "Keyflux"
    },
    "completion_hold_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000,
      "default": 5000
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "working": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "color",
            "brightness"
          ]
        },
        "thinking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "color",
            "brightness"
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "color",
            "brightness"
          ]
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "color",
            "brightness"
          ]
        },
        "attention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "color",
            "brightness"
          ]
        },
        "complete": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "color",
            "brightness"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "color",
            "brightness"
          ]
        }
      },
      "required": []
    }
  },
  "required": []
}
